# =========================
# deepseek2api 配置
# =========================

# ---------------------------------
# 服务监听配置
# ---------------------------------
HOST=127.0.0.1
PORT=8000
API_PREFIX=/v1
LOG_LEVEL=INFO
DEBUG_DUMP_ALL=false
REQUEST_TIMEOUT_SECONDS=180

# ---------------------------------
# 本服务自身鉴权（可选）
# ---------------------------------
SERVER_API_KEYS=

# ---------------------------------
# DeepSeek 上游配置
# ---------------------------------
# Bearer Token（从浏览器请求头 Authorization 中获取，去掉 "Bearer " 前缀）
DEEPSEEK_AUTH_TOKEN=

# 设备 ID（从浏览器请求头 x-device-id 中获取）
DEEPSEEK_DEVICE_ID=

# x-settings-token（从浏览器请求头中获取，JWE 加密格式）
DEEPSEEK_SETTINGS_TOKEN=

# 从浏览器请求头复制完整的 Cookie 字符串
DEEPSEEK_COOKIE=

# 基础 URL
DEEPSEEK_BASE_URL=https://chat.deepseek.com

# WASM 文件路径（DeepSeekHashV1 PoW 求解用，从 chat.deepseek.com 前端 JS 资源中提取）
DEEPSEEK_WASM_PATH=./sha3_wasm_bg.wasm

# 默认模型
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# 是否在每次回答后删除会话
DEEPSEEK_DELETE_CONVERSATION=true

# 是否对所有模型启用 DeepSeek 联网搜索
# true 时：每个 chat 请求都会带 search_enabled=true，DeepSeek 会先联网
#          再回答（响应更慢、更耗上游额度），对所有 model 生效
# false 时：单次请求仍可通过 extra_body.search_enabled 临时开启
DEEPSEEK_SEARCH_ENABLED=false

# 是否剥离上游输出的 [citation:N] / [reference:N] 引用占位符
# DeepSeek Web 前端用它渲染角标，API 直出时会变成纯文本污染 → 默认剥离
# 若想保留（比如自己做 markdown 脚注渲染），设为 false
DEEPSEEK_STRIP_CITATIONS=true

# ---------------------------------
# Vision / 文件上传（可选）
# ---------------------------------
# 是否允许把 OpenAI image_url 上传到 DeepSeek，作为多模态输入。
# true  : messages 中的 image_url 会被上传，file_id 进 ref_file_ids
# false : 图片被忽略（纯文本降级）
DEEPSEEK_FILE_UPLOAD_ENABLED=true

# 最大并发数
DEEPSEEK_MAX_CONCURRENCY=1

# 排队等待超时（秒）
DEEPSEEK_QUEUE_WAIT_TIMEOUT_SECONDS=60

# ---------------------------------
# 服务加固
# ---------------------------------
# 是否发送 CORS 头。默认 false：本服务只给 OpenCode 等本地程序用，
# 不需要浏览器跨域；开启后任意网页都能通过 JS 调用本机接口（烧你的额度）。
CORS_ENABLED=false

# 请求体大小上限（字节），超过返回 413
MAX_REQUEST_BYTES=33554432

# HTTP 并发请求线程数上限
HTTP_MAX_THREADS=64

# ---------------------------------
# 工具调用解析
# ---------------------------------
# 是否启用"JSON 碰运气"式 fallback 解析（代码块/裸 JSON 也当工具调用）。
# 默认 false：只认 DSML/哨兵等明确标记，解析结果更可预期；
# 若模型经常用代码块输出工具调用，可设为 true 恢复旧行为。
TOOL_JSON_FALLBACK=false

# 工具名严格匹配：模型输出的工具名不在 tools 声明中时直接丢弃并告警。
# 默认 true；设为 false 恢复旧的"宽容放行"行为。
TOOL_NAME_STRICT=true

# ---------------------------------
# 防风控
# ---------------------------------
# 是否在每次聊天请求前加入随机延迟（含工具调用）
DEEPSEEK_ANTI_RATE_LIMIT_ENABLED=true

# 随机延迟下限（秒）
DEEPSEEK_ANTI_RATE_LIMIT_MIN_DELAY_SECONDS=1.5

# 随机延迟上限（秒）
DEEPSEEK_ANTI_RATE_LIMIT_MAX_DELAY_SECONDS=3.0

# ---------------------------------
# 管理面板
# ---------------------------------
ADMIN_PASSWORD=admin